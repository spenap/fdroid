{"repo": {"name": {"en-US": "spenap"}, "description": {"en-US": "Apps by Simon Pena, signed with the author's key: the same APKs as each app's GitHub Releases. Source, and how to check a release, are linked from each app."}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "db48dfd0ab4f4ba82f148bb3dc961c45e6197b284ba6c80b792b2458940f8c7b", "size": 136296}}, "address": "https://spenap.github.io/fdroid/repo", "timestamp": 1793907016000, "categories": {"Multimedia": {"name": {"en-US": "Multimedia"}}}}, "packages": {"com.simonpena.unmuffle": {"metadata": {"added": 1793894953000, "categories": ["Multimedia"], "changelog": "https://github.com/spenap/unmuffle/releases", "issueTracker": "https://github.com/spenap/unmuffle/issues", "lastUpdated": 1793894953000, "license": "MIT", "sourceCode": "https://github.com/spenap/unmuffle", "webSite": "https://github.com/spenap/unmuffle", "featureGraphic": {"en-US": {"name": "/com.simonpena.unmuffle/en-US/featureGraphic_KHGMCA5MlMKQ_BU7RpTcW5ReQ9rvsvEQxwrmbPR0y-8=.png", "sha256": "28718c080e4c94c290fc153b4694dc5b945e43daefb2f110c70ae66cf474cbef", "size": 40536}}, "screenshots": {"phone": {"en-US": [{"name": "/com.simonpena.unmuffle/en-US/phoneScreenshots/1-home.png", "sha256": "84214e053d07fcae73a559252add320ab678c5cabca1ac6715df6eb9e8f0d006", "size": 62215}, {"name": "/com.simonpena.unmuffle/en-US/phoneScreenshots/2-transcribing.png", "sha256": "5cf8bd9aa8c899a169ce8289a3974bb719e5f8defb32f2cfe900916a4dc6e387", "size": 58079}, {"name": "/com.simonpena.unmuffle/en-US/phoneScreenshots/3-transcript.png", "sha256": "3aac71818b9792691d4a4e1ec5c1f7fab866825490f00c714ec444ce0182f76e", "size": 96066}]}}, "authorName": "Simon Pena", "name": {"en-US": "Unmuffle"}, "summary": {"en-US": "Read your voice messages, transcribed on your phone"}, "description": {"en-US": "Share a voice message from WhatsApp, Telegram or any app to Unmuffle, and\nit transcribes it on your phone with whisper.cpp. Words appear as they are\ntranscribed, under a player for the audio; words Whisper is unsure of are\nmarked. Copy or share the transcript, or transcribe it again in another\nlanguage.\n\nAudio and transcripts stay on the phone. The only permission is Internet,\nused once to download the Whisper model (MIT licensed) from Hugging Face\nand check it; you can also pick a model file instead.\n\nWritten with AI: Claude Code writes the code, under the author's\ndirection, and it is tested on the author's phones. Each release can be rebuilt from its tag and\ncompared: see the source."}, "icon": {"en-US": {"name": "/com.simonpena.unmuffle/en-US/icon_HypaVc9ve1elS78F8rG0sK-Wk-VP97teDtVCrQXdMGE=.png", "sha256": "1f2a5a55cf6f7b57a54bbf05f2b1b4b0af9693e54ff7bb5e0ed542ad05dd3061", "size": 15556}}, "preferredSigner": "6499956fbadfaf7a06f40eaa329fc07877d79d9aa05f2606e7e30efe62535bcd"}, "versions": {"4d5f5b9c946507b9a3dffa0c5395b99b486d03b738084425276e0f822a425cd1": {"added": 1793894953000, "file": {"name": "/unmuffle-v1.9.0.apk", "sha256": "4d5f5b9c946507b9a3dffa0c5395b99b486d03b738084425276e0f822a425cd1", "size": 5157896}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "v1.9.0", "versionCode": 187, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 37}, "signer": {"sha256": ["6499956fbadfaf7a06f40eaa329fc07877d79d9aa05f2606e7e30efe62535bcd"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "com.simonpena.unmuffle.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}