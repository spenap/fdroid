{"repo": {"name": {"en-US": "Simon Pena's Android Apps"}, "description": {"en-US": "My Android apps: the same APKs as each app's GitHub Releases, signed with the same key. Source, and how to check a release, are linked from each app."}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "db48dfd0ab4f4ba82f148bb3dc961c45e6197b284ba6c80b792b2458940f8c7b", "size": 136296}}, "address": "https://spenap.github.io/fdroid/repo", "timestamp": 1793971926000, "categories": {"Multimedia": {"name": {"en-US": "Multimedia"}}}}, "packages": {"com.simonpena.unmuffle": {"metadata": {"added": 1793894953000, "categories": ["Multimedia"], "changelog": "https://github.com/spenap/unmuffle/releases", "issueTracker": "https://github.com/spenap/unmuffle/issues", "lastUpdated": 1793971921000, "license": "MIT", "sourceCode": "https://github.com/spenap/unmuffle", "webSite": "https://github.com/spenap/unmuffle", "featureGraphic": {"en-US": {"name": "/com.simonpena.unmuffle/en-US/featureGraphic_KQ-6z5NvOHyNrWUDL1tHIfRotQJj2kEL-rUswb8x0Go=.png", "sha256": "290fbacf936f387c8dad65032f5b4721f468b50263da410bfab52cc1bf31d06a", "size": 44924}}, "screenshots": {"phone": {"en-US": [{"name": "/com.simonpena.unmuffle/en-US/phoneScreenshots/1-home.png", "sha256": "84214e053d07fcae73a559252add320ab678c5cabca1ac6715df6eb9e8f0d006", "size": 62215}, {"name": "/com.simonpena.unmuffle/en-US/phoneScreenshots/2-transcribing.png", "sha256": "5cf8bd9aa8c899a169ce8289a3974bb719e5f8defb32f2cfe900916a4dc6e387", "size": 58079}, {"name": "/com.simonpena.unmuffle/en-US/phoneScreenshots/3-transcript.png", "sha256": "f4aee2601f1a3928d4d649d24d22da3b93dfc105ecee52cf9c012469693366b9", "size": 81413}]}}, "authorName": "Simon Pena", "name": {"en-US": "Unmuffle"}, "summary": {"en-US": "Read your voice messages, transcribed on your phone"}, "description": {"en-US": "Share a voice message from WhatsApp, Telegram or any app to Unmuffle, and it transcribes it on your phone with whisper.cpp. Words appear as they are transcribed, under a player for the audio; words Whisper is unsure of are marked. Copy or share the transcript, or transcribe it again in another language.\n\nAudio and transcripts stay on the phone. The only permission is Internet, used once to download the Whisper model (MIT licensed) from Hugging Face and check it; you can also pick a model file instead.\n\nWritten with AI: Claude Code writes the code, under the author's direction, and it is tested on the author's phones. Each release can be rebuilt from its tag and compared: see the source."}, "icon": {"en-US": {"name": "/com.simonpena.unmuffle/en-US/icon_HypaVc9ve1elS78F8rG0sK-Wk-VP97teDtVCrQXdMGE=.png", "sha256": "1f2a5a55cf6f7b57a54bbf05f2b1b4b0af9693e54ff7bb5e0ed542ad05dd3061", "size": 15556}}, "preferredSigner": "6499956fbadfaf7a06f40eaa329fc07877d79d9aa05f2606e7e30efe62535bcd"}, "versions": {"855b89076028c93527312e8a48fcd527edb684cc0f3a677b8ed4f8e24fe33307": {"added": 1793971921000, "file": {"name": "/unmuffle-v1.10.0.apk", "sha256": "855b89076028c93527312e8a48fcd527edb684cc0f3a677b8ed4f8e24fe33307", "size": 5220469}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "v1.10.0", "versionCode": 207, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 37}, "signer": {"sha256": ["6499956fbadfaf7a06f40eaa329fc07877d79d9aa05f2606e7e30efe62535bcd"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "com.simonpena.unmuffle.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "4d5f5b9c946507b9a3dffa0c5395b99b486d03b738084425276e0f822a425cd1": {"added": 1793894953000, "file": {"name": "/unmuffle-v1.9.0.apk", "sha256": "4d5f5b9c946507b9a3dffa0c5395b99b486d03b738084425276e0f822a425cd1", "size": 5157896}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "v1.9.0", "versionCode": 187, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 37}, "signer": {"sha256": ["6499956fbadfaf7a06f40eaa329fc07877d79d9aa05f2606e7e30efe62535bcd"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "com.